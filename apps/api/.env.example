# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=3000

# Business timezone used for date-based logic (invoice dates, reports).
# Timestamps are stored in UTC (timestamptz).
APP_TIMEZONE=Australia/Sydney

# Postgres (matches docker-compose.yml)
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=coffee_crm
POSTGRES_PORT=5432
DATABASE_URL=postgresql://crm:crm@localhost:5432/coffee_crm?schema=public

# Auth: use a long random string (e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Auth sessions (see docs/design/auth-and-customers.md)
JWT_EXPIRES_IN_SECONDS=900
AUTH_SESSION_TTL_HOURS=12
# lax works when web and API share a parent domain (or localhost ports). none needs AUTH_COOKIE_SECURE=true.
AUTH_COOKIE_SAMESITE=lax
# Defaults to true in production, false otherwise.
# AUTH_COOKIE_SECURE=false
# Comma-separated web origins allowed by CORS, e.g. the Vite dev server.
CORS_ORIGINS=http://localhost:5173
# Number of reverse-proxy hops in front of the API (for client IP in login throttling).
TRUST_PROXY=0

# First admin, used by `pnpm api db:seed` (password at least 12 characters)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=change-me-please-12

# Dev-only accounts for manual testing: `pnpm api db:seed:dev` creates admin@example.com,
# manager@example.com and staff@example.com sharing this password. It skips the 12-character
# minimum the admin seed enforces and refuses to run when NODE_ENV=production. Set it on the
# command line or in your own .env; do not commit a value.
# DEV_SEED_PASSWORD=
