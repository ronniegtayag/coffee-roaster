// Coffee Roaster CRM — initial schema.
// Conventions:
// - Money is AUD, stored as Decimal(12,2). Never use Float for money.
// - Amounts are stored ex-GST with GST broken out (Australian tax invoice requirements).
// - Timestamps are timestamptz (UTC); business dates (issue/due/delivery) are plain dates
//   interpreted in Australia/Sydney.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

enum AustralianState {
  NSW
  VIC
  QLD
  WA
  SA
  TAS
  ACT
  NT
}

/// GST treatment per line. Most coffee beans are GST-free; merch/equipment attract 10% GST.
/// Confirm product classifications with your accountant.
enum TaxCode {
  GST
  GST_FREE
}

enum RoastLevel {
  LIGHT
  MEDIUM
  MEDIUM_DARK
  DARK
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  ROASTING
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  DIRECT_DEBIT
  CASH
  OTHER
}

enum SupplierInvoiceStatus {
  RECEIVED
  APPROVED
  PAID
  VOID
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Stored trimmed and lower-cased (CHECK users_email_normalised_chk), so @unique is case-insensitive.
  email        String   @unique
  /// scrypt hash in PHC-like format, see docs/design/auth-and-customers.md.
  passwordHash String
  name         String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  sessions AuthSession[]

  @@map("users")
}

/// A login session backing the httpOnly refresh cookie. The cookie holds a random secret;
/// only its SHA-256 hash is stored. Fixed expiry from login (not extended by refresh).
model AuthSession {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  lastUsedAt DateTime? @db.Timestamptz(6)
  userAgent  String?   @db.VarChar(255)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// ─── Customers ───────────────────────────────────────────────────────────────

/// The billed entity (cafe business / chain). Invoices are issued to the customer.
model Customer {
  id               String    @id @default(uuid(7)) @db.Uuid
  legalName        String
  tradingName      String?
  abn              String?   @unique @db.VarChar(11)
  billingEmail     String
  phone            String?
  paymentTermsDays Int       @default(14)
  isActive         Boolean   @default(true)
  /// Set when deactivated, cleared on reactivation.
  deactivatedAt    DateTime? @db.Timestamptz(6)
  notes            String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  branches Branch[]
  invoices Invoice[]

  @@index([legalName])
  @@index([isActive])
  @@map("customers")
}

/// A physical cafe location. Orders are placed for (and delivered to) a branch.
model Branch {
  id            String          @id @default(uuid(7)) @db.Uuid
  customerId    String          @db.Uuid
  name          String
  addressLine1  String
  addressLine2  String?
  suburb        String
  state         AustralianState
  postcode      String          @db.VarChar(4)
  contactName   String?
  contactPhone  String?
  deliveryNotes String?
  isActive      Boolean         @default(true)
  /// Set when deactivated, cleared on reactivation.
  deactivatedAt DateTime?       @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orders   Order[]

  @@index([customerId])
  @@index([state])
  @@map("branches")
}

// ─── Catalogue & inventory ───────────────────────────────────────────────────

/// One row per sellable SKU (e.g. "Ethiopia Yirgacheffe 1kg").
model Product {
  id             String      @id @default(uuid(7)) @db.Uuid
  sku            String      @unique
  name           String
  origin         String?
  roastLevel     RoastLevel?
  weightGrams    Int
  unitPriceExGst Decimal     @db.Decimal(12, 2)
  taxCode        TaxCode     @default(GST_FREE)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)

  orderItems    OrderItem[]
  inventoryItem InventoryItem?

  @@map("products")
}

/// Roasted stock on hand, counted in units of the product SKU.
model InventoryItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  productId      String   @unique @db.Uuid
  quantityOnHand Int      @default(0)
  reorderLevel   Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory_items")
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id                    String      @id @default(uuid(7)) @db.Uuid
  orderNumber           String      @unique
  branchId              String      @db.Uuid
  invoiceId             String?     @db.Uuid
  status                OrderStatus @default(DRAFT)
  orderedAt             DateTime    @default(now()) @db.Timestamptz(6)
  requestedDeliveryDate DateTime?   @db.Date
  notes                 String?
  createdAt             DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime    @updatedAt @db.Timestamptz(6)

  branch  Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  /// An invoice may consolidate several orders (e.g. weekly billing for a chain).
  invoice Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  items   OrderItem[]

  @@index([branchId])
  @@index([invoiceId])
  @@index([status])
  @@map("orders")
}

/// Price and tax code are snapshotted at order time.
model OrderItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  orderId        String   @db.Uuid
  productId      String   @db.Uuid
  quantity       Int
  unitPriceExGst Decimal  @db.Decimal(12, 2)
  taxCode        TaxCode
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ─── Invoicing ───────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(uuid(7)) @db.Uuid
  invoiceNumber String        @unique
  customerId    String        @db.Uuid
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime?     @db.Date
  dueDate       DateTime?     @db.Date
  subtotalExGst Decimal       @default(0) @db.Decimal(12, 2)
  gstAmount     Decimal       @default(0) @db.Decimal(12, 2)
  totalIncGst   Decimal       @default(0) @db.Decimal(12, 2)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(6)

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orders   Order[]
  payments Payment[]

  @@index([customerId])
  @@index([status, dueDate])
  @@map("invoices")
}

model Payment {
  id        String        @id @default(uuid(7)) @db.Uuid
  invoiceId String        @db.Uuid
  amount    Decimal       @db.Decimal(12, 2)
  paidAt    DateTime      @db.Timestamptz(6)
  method    PaymentMethod
  reference String?
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @db.Timestamptz(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("payments")
}

// ─── Suppliers ───────────────────────────────────────────────────────────────

model Supplier {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  abn       String?  @unique @db.VarChar(11)
  email     String?
  phone     String?
  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  supplierInvoices SupplierInvoice[]

  @@map("suppliers")
}

model SupplierInvoice {
  id            String                @id @default(uuid(7)) @db.Uuid
  supplierId    String                @db.Uuid
  invoiceNumber String
  status        SupplierInvoiceStatus @default(RECEIVED)
  issueDate     DateTime              @db.Date
  dueDate       DateTime              @db.Date
  subtotalExGst Decimal               @db.Decimal(12, 2)
  gstAmount     Decimal               @db.Decimal(12, 2)
  totalIncGst   Decimal               @db.Decimal(12, 2)
  createdAt     DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(6)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@unique([supplierId, invoiceNumber])
  @@index([status, dueDate])
  @@map("supplier_invoices")
}
