// Coffee Roaster CRM — initial schema.
// Conventions:
// - Money is AUD, stored as Decimal(12,2). Never use Float for money.
// - Amounts are stored ex-GST with GST broken out (Australian tax invoice requirements).
// - Timestamps are timestamptz (UTC); business dates (issue/due/delivery) are plain dates
//   interpreted in Australia/Sydney.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

enum AustralianState {
  NSW
  VIC
  QLD
  WA
  SA
  TAS
  ACT
  NT
}

/// GST treatment per line. Most coffee beans are GST-free; merch/equipment attract 10% GST.
/// Confirm product classifications with your accountant.
enum TaxCode {
  GST
  GST_FREE
}

enum CoffeeType {
  SINGLE_ORIGIN
  BLEND
}

/// Commercial and dispatch lifecycle only. Roasting is batched across orders, so it is not an
/// order status. Allowed transitions: docs/design/ordering.md §4.
enum OrderStatus {
  DRAFT
  CONFIRMED
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum OrderEventType {
  CREATED
  UPDATED
  CONFIRMED
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
  REVERTED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  DIRECT_DEBIT
  CASH
  OTHER
}

enum SupplierInvoiceStatus {
  RECEIVED
  APPROVED
  PAID
  VOID
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Stored trimmed and lower-cased (CHECK users_email_normalised_chk), so @unique is case-insensitive.
  email        String   @unique
  /// scrypt hash in PHC-like format, see docs/design/auth-and-customers.md.
  passwordHash String
  name         String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  sessions      AuthSession[]
  ordersCreated Order[]       @relation("OrderCreatedBy")
  ordersUpdated Order[]       @relation("OrderUpdatedBy")
  orderEvents   OrderEvent[]

  @@map("users")
}

/// A login session backing the httpOnly refresh cookie. The cookie holds a random secret;
/// only its SHA-256 hash is stored. Fixed expiry from login (not extended by refresh).
model AuthSession {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  lastUsedAt DateTime? @db.Timestamptz(6)
  userAgent  String?   @db.VarChar(255)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// ─── Customers ───────────────────────────────────────────────────────────────

/// The billed entity (cafe business / chain). Invoices are issued to the customer.
model Customer {
  id               String    @id @default(uuid(7)) @db.Uuid
  legalName        String
  tradingName      String?
  abn              String?   @unique @db.VarChar(11)
  billingEmail     String
  phone            String?
  paymentTermsDays Int       @default(14)
  isActive         Boolean   @default(true)
  /// Set when deactivated, cleared on reactivation.
  deactivatedAt    DateTime? @db.Timestamptz(6)
  notes            String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  branches Branch[]
  invoices Invoice[]
  orders   Order[]

  @@index([legalName])
  @@index([isActive])
  @@map("customers")
}

/// A physical cafe location. Orders are placed for (and delivered to) a branch.
model Branch {
  id            String          @id @default(uuid(7)) @db.Uuid
  customerId    String          @db.Uuid
  name          String
  addressLine1  String
  addressLine2  String?
  suburb        String
  state         AustralianState
  postcode      String          @db.VarChar(4)
  contactName   String?
  contactPhone  String?
  deliveryNotes String?
  isActive      Boolean         @default(true)
  /// Set when deactivated, cleared on reactivation.
  deactivatedAt DateTime?       @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orders   Order[]

  @@index([customerId])
  @@index([state])
  @@map("branches")
}

// ─── Catalogue & inventory ───────────────────────────────────────────────────

/// What gets roasted (G1). Roast demand is summed per coffee across its products.
model Coffee {
  id            String     @id @default(uuid(7)) @db.Uuid
  /// Unique case-insensitively, ignoring outer spaces (index coffees_name_lower_key, hand-written).
  name          String
  type          CoffeeType
  origin        String?
  description   String?
  isActive      Boolean    @default(true)
  deactivatedAt DateTime?  @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(6)

  products Product[]

  @@index([isActive])
  @@map("coffees")
}

/// Grind options (Whole bean, Espresso, Filter by default). A table, not an enum, so the
/// list can change without a code change (brief P1).
model Grind {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Also unique case-insensitively (index grinds_name_lower_key, hand-written).
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  products Product[]

  @@map("grinds")
}

/// One sellable item. A coffee product is coffee + bag size + grind (name is null, the display
/// name is built). A non-coffee product has a name and no coffee, bag size or grind
/// (CHECK products_kind_chk). coffeeId, bagSizeGrams and grindId never change after creation.
/// At most one ACTIVE product per coffee + bag size + grind (partial unique index
/// products_active_variant_key, hand-written in the migration).
model Product {
  id             String    @id @default(uuid(7)) @db.Uuid
  /// Stored trimmed and upper-cased (CHECK products_sku_normalised_chk).
  sku            String    @unique
  name           String?
  coffeeId       String?   @db.Uuid
  bagSizeGrams   Int?
  grindId        String?   @db.Uuid
  /// List price ex-GST per unit, the same for every customer (D-LEAD-3). Copied onto order lines.
  listPriceExGst Decimal   @db.Decimal(12, 2)
  taxCode        TaxCode
  isActive       Boolean   @default(true)
  deactivatedAt  DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  coffee        Coffee?        @relation(fields: [coffeeId], references: [id], onDelete: Restrict)
  grind         Grind?         @relation(fields: [grindId], references: [id], onDelete: Restrict)
  orderItems    OrderItem[]
  inventoryItem InventoryItem?

  @@index([coffeeId])
  @@index([grindId])
  @@index([isActive])
  @@map("products")
}

/// Roasted stock on hand, counted in units of the product SKU.
model InventoryItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  productId      String   @unique @db.Uuid
  quantityOnHand Int      @default(0)
  reorderLevel   Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("inventory_items")
}

// ─── Orders ──────────────────────────────────────────────────────────────────

/// A staff-entered order for one branch. Totals are stored, recomputed from the lines in the
/// same transaction as any line change. customerId is copied from the branch (branches never
/// move between customers, D-PO-5).
model Order {
  id               String      @id @default(uuid(7)) @db.Uuid
  /// Shown as "ORD-<n>"; the sequence starts at 1001 (hand-written in the migration).
  orderNumber      Int         @unique @default(autoincrement())
  /// Client-generated id that makes POST /orders idempotent (double-click on Save).
  requestId        String      @unique @db.Uuid
  customerId       String      @db.Uuid
  branchId         String      @db.Uuid
  invoiceId        String?     @db.Uuid
  status           OrderStatus @default(DRAFT)
  /// Business dates, plain Australia/Sydney dates.
  deliveryDate     DateTime    @db.Date
  roastDate        DateTime    @db.Date
  /// True when lines or dates were last saved off-schedule (past cut-off or overridden dates).
  afterCutoff      Boolean     @default(false)
  notes            String?
  subtotalExGst    Decimal     @default(0) @db.Decimal(12, 2)
  gstAmount        Decimal     @default(0) @db.Decimal(12, 2)
  totalIncGst      Decimal     @default(0) @db.Decimal(12, 2)
  /// Sum of bag size x quantity over coffee lines (brief O2 Should, roast demand later).
  /// BigInt: 200 lines x 999 bags x 100 kg exceeds Int4. DTOs send a JSON number (safe below 2^53).
  totalWeightGrams BigInt      @default(0)
  /// Optimistic concurrency: every write must send the version it read (brief O4).
  version          Int         @default(1)
  cancelReason     String?
  /// Set the first time the order is confirmed; never cleared (a Draft with this set can't be deleted).
  confirmedAt      DateTime?   @db.Timestamptz(6)
  packedAt         DateTime?   @db.Timestamptz(6)
  dispatchedAt     DateTime?   @db.Timestamptz(6)
  deliveredAt      DateTime?   @db.Timestamptz(6)
  cancelledAt      DateTime?   @db.Timestamptz(6)
  createdById      String      @db.Uuid
  updatedById      String      @db.Uuid
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(6)

  customer  Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  /// An invoice may consolidate several orders (Q4). The MYOB invoice id will live on Invoice.
  invoice   Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy User         @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User         @relation("OrderUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  items     OrderItem[]
  events    OrderEvent[]

  @@index([customerId])
  @@index([branchId])
  @@index([invoiceId])
  @@index([status])
  @@index([deliveryDate])
  @@index([roastDate])
  @@index([createdById])
  @@index([updatedById])
  @@map("orders")
}

/// Price, tax code and description are snapshotted when the line is added (D-PO-10).
/// Line amounts are stored so the future MYOB invoice uses exactly these figures (G6).
model OrderItem {
  id              String   @id @default(uuid(7)) @db.Uuid
  orderId         String   @db.Uuid
  productId       String   @db.Uuid
  /// Product display name when the line was added, e.g. "House Espresso — 1 kg — Whole bean".
  description     String
  /// Whole bags, 1 to 999 (CHECK order_items_quantity_chk).
  quantity        Int
  unitPriceExGst  Decimal  @db.Decimal(12, 2)
  taxCode         TaxCode
  lineTotalExGst  Decimal  @db.Decimal(12, 2)
  gstAmount       Decimal  @db.Decimal(12, 2)
  lineTotalIncGst Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// One line per product per order (D-PO-11). Also serves as the orderId index.
  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

/// Who did what to an order, and when (brief S3, G27). Append-only.
model OrderEvent {
  id      String         @id @default(uuid(7)) @db.Uuid
  orderId String         @db.Uuid
  type    OrderEventType
  userId  String         @db.Uuid
  /// Cancel/revert reason, or a short-supply note.
  reason  String?
  /// Before/after of changed fields, e.g. { "lines": [...], "deliveryDate": ["2026-11-26", "2026-11-27"] }.
  changes Json?
  at      DateTime       @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([userId])
  @@map("order_events")
}

/// Roast and delivery calendar (brief R1, R3). A single row (CHECK id = 1), inserted with the
/// defaults by the migration. Weekdays are ISO numbers, 1 = Monday ... 7 = Sunday.
/// Defaults are assumptions (Q6, OQ-PO-8).
model RoastCalendarSettings {
  id                      Int      @id @default(1)
  roastDays               Int[]
  deliveryDays            Int[]
  businessDays            Int[]
  /// Sydney wall-clock time, "HH:mm".
  cutoffTime              String   @db.VarChar(5)
  /// The cut-off falls this many business days before the roast day.
  cutoffLeadBusinessDays  Int
  /// Earliest delivery is this many business days after the roast day.
  deliveryLagBusinessDays Int
  updatedAt               DateTime @updatedAt @db.Timestamptz(6)

  @@map("roast_calendar_settings")
}

/// A day that is neither a business, roast nor delivery day (brief R2).
model ClosureDay {
  id          String   @id @default(uuid(7)) @db.Uuid
  date        DateTime @unique @db.Date
  description String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@map("closure_days")
}

// ─── Invoicing ───────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(uuid(7)) @db.Uuid
  invoiceNumber String        @unique
  customerId    String        @db.Uuid
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime?     @db.Date
  dueDate       DateTime?     @db.Date
  subtotalExGst Decimal       @default(0) @db.Decimal(12, 2)
  gstAmount     Decimal       @default(0) @db.Decimal(12, 2)
  totalIncGst   Decimal       @default(0) @db.Decimal(12, 2)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(6)

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orders   Order[]
  payments Payment[]

  @@index([customerId])
  @@index([status, dueDate])
  @@map("invoices")
}

model Payment {
  id        String        @id @default(uuid(7)) @db.Uuid
  invoiceId String        @db.Uuid
  amount    Decimal       @db.Decimal(12, 2)
  paidAt    DateTime      @db.Timestamptz(6)
  method    PaymentMethod
  reference String?
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @db.Timestamptz(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("payments")
}

// ─── Suppliers ───────────────────────────────────────────────────────────────

model Supplier {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  abn       String?  @unique @db.VarChar(11)
  email     String?
  phone     String?
  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  supplierInvoices SupplierInvoice[]

  @@map("suppliers")
}

model SupplierInvoice {
  id            String                @id @default(uuid(7)) @db.Uuid
  supplierId    String                @db.Uuid
  invoiceNumber String
  status        SupplierInvoiceStatus @default(RECEIVED)
  issueDate     DateTime              @db.Date
  dueDate       DateTime              @db.Date
  subtotalExGst Decimal               @db.Decimal(12, 2)
  gstAmount     Decimal               @db.Decimal(12, 2)
  totalIncGst   Decimal               @db.Decimal(12, 2)
  createdAt     DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(6)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@unique([supplierId, invoiceNumber])
  @@index([status, dueDate])
  @@map("supplier_invoices")
}
