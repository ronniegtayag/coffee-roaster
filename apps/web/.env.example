# Copy to .env.local and adjust. Every VITE_* value is bundled into the public JS: never put secrets here.

# API origin. Leave empty in dev: Vite proxies /api, /health and /docs to DEV_API_TARGET.
# Production example: VITE_API_URL=https://api.example.com
VITE_API_URL=

# Dev server only (read in vite.config.ts, not exposed to the browser).
DEV_API_TARGET=http://localhost:3000
