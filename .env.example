# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=3000

# Business timezone used for date-based logic (invoice dates, reports).
# Timestamps are stored in UTC (timestamptz).
APP_TIMEZONE=Australia/Sydney

# Postgres (matches docker-compose.yml)
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=coffee_crm
POSTGRES_PORT=5432
DATABASE_URL=postgresql://crm:crm@localhost:5432/coffee_crm?schema=public

# Auth: use a long random string (e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN_SECONDS=3600
