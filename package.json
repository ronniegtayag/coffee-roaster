{
  "name": "coffee-roaster",
  "version": "0.1.0",
  "private": true,
  "description": "Coffee Roaster CRM monorepo: apps/api (NestJS) and apps/web (React)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "api": "pnpm --filter @coffee/api",
    "web": "pnpm --filter @coffee/web",
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:up": "docker compose --env-file apps/api/.env up -d postgres",
    "db:down": "docker compose --env-file apps/api/.env down",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
