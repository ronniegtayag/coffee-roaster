#!/bin/sh
# Runs `pnpm check` before every push; there is no CI. Skip once with: git push --no-verify
set -e

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-push: pnpm not found on PATH, so checks can't run. Install pnpm or push with --no-verify." >&2
  exit 1
fi

if [ -n "$(git status --porcelain)" ]; then
  echo "pre-push: note: you have uncommitted changes; checks run on the working tree, not only on what you push." >&2
fi

echo "pre-push: running pnpm check..."
if ! pnpm check; then
  echo "pre-push: pnpm check failed, push cancelled. Fix the errors above, or skip once with --no-verify." >&2
  exit 1
fi
